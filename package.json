{
  "name": "flow-omp",
  "version": "0.7.0",
  "private": true,
  "description": "Ambient scenes that move with your coding agent's work, for OMP, pi and Claude Code",
  "author": "Rob Macrae",
  "license": "MIT",
  "repository": "github:GowangInc/flow-omp",
  "keywords": [
    "pi-package",
    "omp",
    "claude-code",
    "fun",
    "animation",
    "ambient",
    "terminal-art"
  ],
  "pi": {
    "extensions": [
      "./pi/index.ts"
    ]
  },
  "omp": {
    "extensions": [
      "./pi/index.ts"
    ]
  },
  "scripts": {
    "new-scene": "tsx scripts/new-scene.ts",
    "preview": "tsx scripts/preview.ts",
    "check": "tsx scripts/check.ts",
    "typecheck": "tsc -p . && tsc -p tsconfig.node.json",
    "cvd": "tsx scripts/cvd-check.ts",
    "sync": "tsx scripts/sync-manifest.ts",
    "sounds": "tsx scripts/make-sounds.ts"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3"
  }
}
